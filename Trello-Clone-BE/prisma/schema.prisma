// Source of truth for the data model (docs/database/schema.md keeps explanations and the changelog).
// Prisma 7 (ADR-015): the connection URL lives in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global identity; not tenant-scoped. Introduced in FOUNDATION-004, used from AUTH-001.
model User {
  id            String            @id @default(cuid())
  /// Stored lower-cased.
  email         String            @unique
  /// bcrypt hash; never returned by the API.
  passwordHash  String
  name          String
  /// URL only; uploads are out of scope.
  avatarUrl     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  refreshTokens RefreshToken[]
  memberships   WorkspaceMember[]
  invitesSent   WorkspaceInvite[]
  activities    Activity[]
  cards         CardMember[]
}

/// One refresh token of a login's rotation chain (security.md → Authentication flow). AUTH-001.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  /// sha256 of the raw token (hex); the raw token is never stored.
  tokenHash    String    @unique
  /// Groups one login's rotations; required for reuse detection.
  familyId     String
  /// Absolute expiry of the family, kept across rotations (D-02).
  expiresAt    DateTime
  /// Set when rotated, logged out, or the family is revoked.
  revokedAt    DateTime?
  /// Next token in the rotation chain (audit/debug).
  replacedById String?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

/// Workspace role; order OWNER > ADMIN > MEMBER > VIEWER (docs/api/README.md → Authorization model). WORKSPACE-001.
enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

/// Billing plan; the column exists from WORKSPACE-001, it is changed only by BILLING-001 webhooks.
enum Plan {
  FREE
  PRO
}

/// The tenant: every board and its content belongs to one workspace. WORKSPACE-001.
model Workspace {
  id        String            @id @default(cuid())
  name      String
  /// URL `/w/:slug`; generated from the name, random suffix on collision.
  slug      String            @unique
  plan      Plan              @default(FREE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]
  invites   WorkspaceInvite[]
  boards    Board[]
}

/// A user's membership and role in a workspace. WORKSPACE-001.
model WorkspaceMember {
  userId      String
  workspaceId String
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

/// A pending (or accepted, kept for audit) invitation by email. WORKSPACE-004.
model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  /// Stored lower-cased; one row per email per workspace (re-inviting replaces it).
  email       String
  /// Never OWNER (I5; enforced by validation).
  role        Role      @default(MEMBER)
  /// sha256 of the raw token (hex); the raw token is only in the invite link.
  tokenHash   String    @unique
  invitedById String
  /// Now + D-17 (7 days).
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
  @@index([invitedById])
}

/// Activity log event types; later tasks add theirs (docs/database/schema.md). BOARD-001.
enum ActivityType {
  BOARD_CREATED
  BOARD_UPDATED
  LIST_CREATED
  LIST_UPDATED
  LIST_ARCHIVED
  LIST_MOVED
  CARD_CREATED
  CARD_UPDATED
  CARD_ARCHIVED
  CARD_MOVED
  MEMBER_ADDED
  MEMBER_REMOVED
}

/// A Kanban board inside a workspace. BOARD-001.
model Board {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  /// Hex colour `#rrggbb`; the UI offers the presets in docs/design/ui.md.
  background  String     @default("#0079bf")
  archived    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  activities  Activity[]
  lists       List[]
  cards       Card[]
  labels      Label[]

  @@index([workspaceId, archived])
}

/// A column of cards on a board, ordered by `position ASC, id ASC`
/// (docs/database/relationships.md → Ordering). LIST-001.
model List {
  id        String   @id @default(cuid())
  boardId   String
  title     String
  position  Float
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([boardId, position])
}

/// A card in a list, ordered by `position ASC, id ASC`. `boardId` always equals the list's
/// (invariant I1): it is denormalized for one-query authorization and board-wide queries. CARD-001.
model Card {
  id          String       @id @default(cuid())
  boardId     String
  listId      String
  title       String
  /// Raw markdown (CARD-002).
  description String?
  position    Float
  dueDate     DateTime?
  completed   Boolean      @default(false)
  /// Unused until ATTACHMENTS-001.
  coverUrl    String?
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  list        List         @relation(fields: [listId], references: [id], onDelete: Cascade)
  activities  Activity[]
  labels      CardLabel[]
  members     CardMember[]

  @@index([listId, position])
  @@index([boardId])
}

/// A board's label (CARD-005); a board starts with six colour-only defaults.
model Label {
  id      String      @id @default(cuid())
  boardId String
  /// May be empty (a colour-only label).
  name    String      @default("")
  /// Hex colour `#rrggbb`; the UI offers the presets in docs/design/ui.md.
  color   String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards   CardLabel[]

  @@index([boardId])
}

/// A label on a card; both belong to the same board (invariant I2). CARD-005.
model CardLabel {
  cardId  String
  labelId String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  /// Deleting a label detaches it from its cards.
  @@index([labelId])
}

/// A workspace member assigned to a card (invariant I3: only members of the card's workspace).
/// CARD-005.
model CardMember {
  cardId String
  userId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([cardId, userId])
  /// Serves "cards assigned to me" and removing a member's assignments.
  @@index([userId])
}

/// Append-only board activity feed. BOARD-001; `cardId` since CARD-001.
model Activity {
  id        String       @id @default(cuid())
  boardId   String
  /// The card the event is about; null for board and list events, and once the card is deleted.
  cardId    String?
  /// The actor.
  userId    String
  type      ActivityType
  /// Event details; the shape per type is in @trello-clone/shared.
  data      Json
  createdAt DateTime     @default(now())
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  card      Card?        @relation(fields: [cardId], references: [id], onDelete: SetNull)
  user      User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([boardId, createdAt])
  @@index([cardId, createdAt])
}
