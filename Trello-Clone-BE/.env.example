# Copy to .env and fill in. Never commit .env. Descriptions: docs/development/setup.md
NODE_ENV=
PORT=
CLIENT_URL=
DATABASE_URL=
# Tests only; the database name must end in _test
DATABASE_URL_TEST=
# Password for the seeded demo user (db:seed); required by the seed
SEED_DEMO_PASSWORD=
JWT_ACCESS_SECRET=
# Proposed default 15m (D-01)
ACCESS_TOKEN_TTL=
# Proposed default 30 (D-02)
REFRESH_TOKEN_TTL_DAYS=
# Proxies in front of the API: 0 locally (default), 1 on Render (DEPLOYMENT-001)
TRUST_PROXY=
# Attachments (ADR-020): a private S3 bucket. S3_ENDPOINT only for S3-compatible stores (MinIO)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
# Proposed default 3600 (D-27)
S3_URL_TTL_SECONDS=
# Standard AWS SDK credentials for the bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Billing (BILLING-001): Stripe test-mode keys, the webhook signing secret and the Pro price id
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
# Error tracking (ADR-024): empty = off. SENTRY_ENVIRONMENT is staging or production on Render
SENTRY_DSN=
SENTRY_ENVIRONMENT=
