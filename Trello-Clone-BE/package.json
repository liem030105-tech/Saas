{
  "name": "@trello-clone/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node scripts/check-prisma-client.mjs && tsdown",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "typecheck": "node scripts/check-prisma-client.mjs && tsc --noEmit",
    "test": "node scripts/check-prisma-client.mjs && vitest run",
    "test:coverage": "node scripts/check-prisma-client.mjs && vitest run --coverage --coverage.include='src/**' --coverage.reporter=text-summary --coverage.reporter=html --coverage.exclude='src/generated/**'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@trello-clone/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "prisma": "7.10.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.0",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "vitest": "4.1.11"
  }
}
